# Served by Hostinger. Astro emits one folder per page with an index.html inside.
RewriteEngine On

# Force HTTPS.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Hostinger's Git deployment leaves a .git folder in the web root: never serve it.
RedirectMatch 404 /\.git

# Unknown routes get the site's own 404 page.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Astro fingerprints its JS, CSS and font files: they can be cached for a year.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
