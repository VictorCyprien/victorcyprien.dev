# Served by Hostinger. Astro emits one folder per page with an index.html inside.
RewriteEngine On

# One address per site: www goes to the bare host. The host stays generic so the preview keeps its own.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Force HTTPS.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Hostinger's Git deployment leaves a .git folder in the web root: never serve it.
RedirectMatch 404 /\.git

# Unknown routes get the site's own 404 page.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Security headers, on every answer including errors.
  # The CSP lets the browser enforce the project rule "no request to a third party": everything comes
  # from the site itself. Astro writes small scripts and styles into the pages, and Vite inlines small
  # font files as data: URIs, hence 'unsafe-inline' and data: fonts. tests/e2e/csp.spec.ts checks every
  # page against this exact policy.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HTTPS is stable on the domain, so browsers keep to it for a year. Subdomains are left out on purpose.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Astro fingerprints its JS, CSS and font files: they can be cached for a year.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
