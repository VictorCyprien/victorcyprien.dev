---
import Schema from './Schema.astro';
import { getSite } from '../lib/content';

const site = await getSite();
---

<section class="mx-auto grid max-w-6xl items-center gap-12 px-6 pb-16 pt-10 md:px-12 lg:grid-cols-[minmax(0,1fr)_390px] lg:gap-14">
  <div>
    <p class="mb-6 flex items-center gap-3 text-muted">
      {site.photo && <img src={site.photo} alt="" width="44" height="44" class="h-11 w-11 rounded-full object-cover" />}
      <span><span class="font-medium text-text">{site.name}</span>, {site.role}</span>
    </p>
    <h1 class="mb-5 max-w-[15ch] text-4xl font-semibold leading-[1.06] tracking-tight md:text-[46px]">{site.headline}</h1>
    <p class="mb-7 max-w-[32em] text-lg leading-relaxed text-muted">{site.lead}</p>
    <div class="flex flex-wrap gap-3">
      <a href={site.callHref} class="rounded-[10px] bg-cta px-5 py-3 font-medium text-cta-text">Réserver un appel</a>
      <a href="#projets" class="rounded-[10px] border border-line px-5 py-3">Voir les projets</a>
    </div>
  </div>
  <Schema caption={site.schemaCaption} />
</section>
