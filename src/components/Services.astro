---
import { getCaseStudyNames, getServices } from '../lib/content';

const services = await getServices();
// Only published studies count as proof: a draft is left out of the build.
const names = await getCaseStudyNames();
---

<!-- Rows like the legend of a plan: the service on the left, what it means and its proof on the right. -->
<section id="services" class="section-rule mx-auto max-w-6xl px-6 py-20 md:px-12">
  <h2 class="mb-2 text-3xl font-semibold tracking-tight">Ce que je fais</h2>
  <p class="mb-10 max-w-[40em] text-muted">Sur une application neuve ou déjà en place, je prends en charge tout ou partie de ces étapes.</p>
  <ul class="divide-y divide-line border-y border-line">
    {services.map(({ data }) => {
      const proof = data.proof.filter((ref) => names.has(ref.id));
      return (
        <li class="grid gap-2 py-7 md:grid-cols-[300px_minmax(0,1fr)] md:gap-12">
          <h3 class="text-lg font-semibold leading-snug">{data.title}</h3>
          <div>
            <p class="max-w-[42em] leading-relaxed text-muted">{data.text}</p>
            {proof.length > 0 && (
              <p class="mt-3 text-sm text-muted">
                {proof.length > 1 ? 'Exemples' : 'Exemple'}&nbsp;: {proof.map((ref, i) => <>{i > 0 && ', '}<a href={`/etudes-de-cas/${ref.id}/`} class="link">{names.get(ref.id)}</a></>)}
              </p>
            )}
          </div>
        </li>
      );
    })}
  </ul>
</section>
