<button
  type="button"
  data-theme-toggle
  aria-label="Passer en thème clair"
  class="flex h-9 w-9 items-center justify-center rounded-[10px] border border-line text-muted transition hover:border-muted hover:text-text active:translate-y-px"
>
  <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
</button>

<style>
  /* The icon shows the theme the button switches to. */
  :global([data-theme='dark']) .theme-icon-moon,
  :global([data-theme='light']) .theme-icon-sun {
    display: none;
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;

  function apply(theme: 'dark' | 'light') {
    root.dataset.theme = theme;
    // The browser bar (mobile address bar, tab strip) takes the page background of the active theme.
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', getComputedStyle(root).getPropertyValue('--bg').trim());
    button?.setAttribute('aria-label', theme === 'dark' ? 'Passer en thème clair' : 'Passer en thème sombre');
  }

  // The chosen theme, kept here because a crossfade applies it a frame after the click.
  let chosen: 'dark' | 'light' = root.dataset.theme === 'light' ? 'light' : 'dark';
  apply(chosen);

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  button?.addEventListener('click', () => {
    const next = chosen === 'dark' ? 'light' : 'dark';
    chosen = next;
    // Crossfade where the browser can; otherwise, or when motion is reduced, the theme switches at once.
    // A crossfade cut short by the next click still applies its theme, so its rejection is expected.
    if (document.startViewTransition && !reducedMotion.matches) document.startViewTransition(() => apply(next)).ready.catch(() => {});
    else apply(next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage can be blocked (private mode): the theme still switches for this page.
    }
  });
</script>
