---
import { getSite } from '../lib/content';

const site = await getSite();
---

<!-- The closing band mirrors the principles band: the page ends on the action, not on a list. -->
<section id="contact" class="border-t border-line bg-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-20 md:grid-cols-[minmax(0,1fr)_auto] md:items-end md:gap-16 md:px-12">
    <div>
      <h2 class="mb-4 text-4xl font-semibold tracking-tight">Contact</h2>
      <p class="mb-8 max-w-[34em] text-lg leading-relaxed text-muted">Un projet à cadrer, une application à reprendre ou à mettre en production&nbsp;: parlons-en.</p>
      <a href={site.callHref} class="inline-block rounded-[10px] bg-cta px-5 py-3 font-medium text-cta-text transition hover:brightness-110 active:translate-y-px">Réserver un appel</a>
    </div>
    <ul class="grid gap-3 text-sm md:justify-items-end">
      <li><a href={`mailto:${site.email}`} class="border-b border-line transition-colors hover:border-text">{site.email}</a></li>
      <li><a href={site.links.linkedin} class="border-b border-line transition-colors hover:border-text">LinkedIn</a></li>
      <li><a href={site.links.github} class="border-b border-line transition-colors hover:border-text">GitHub</a></li>
      <li><a href={site.links.malt} class="border-b border-line transition-colors hover:border-text">Malt</a></li>
    </ul>
  </div>
</section>
