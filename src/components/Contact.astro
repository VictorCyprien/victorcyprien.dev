---
import { getSite } from '../lib/content';

const site = await getSite();
---

<section id="contact" class="mx-auto max-w-6xl px-6 py-16 md:px-12">
  <h2 class="mb-4 text-3xl font-semibold tracking-tight">Contact</h2>
  <p class="mb-6 max-w-[40em] text-muted">Un projet à cadrer, une application à reprendre ou à mettre en production&nbsp;: parlons-en.</p>
  <a href={site.callHref} class="inline-block rounded-[10px] bg-cta px-5 py-3 font-medium text-cta-text">Réserver un appel</a>
  <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm">
    <li><a href={`mailto:${site.email}`} class="border-b border-line">{site.email}</a></li>
    <li><a href={site.links.linkedin} class="border-b border-line">LinkedIn</a></li>
    <li><a href={site.links.github} class="border-b border-line">GitHub</a></li>
    <li><a href={site.links.malt} class="border-b border-line">Malt</a></li>
  </ul>
</section>
