---
import { getSite } from '../lib/content';

const site = await getSite();
const year = new Date().getFullYear();
---

<!-- A full-width band, like the principles and contact bands. -->
<footer class="border-t border-line bg-surface text-sm text-muted">
  <div class="mx-auto flex max-w-6xl flex-wrap gap-x-6 gap-y-2 px-6 py-8 md:px-12">
    <span class="mr-auto">© {year} {site.name}</span>
    <a href="/etudes-de-cas/" class="transition-colors hover:text-text">Études de cas</a>
    <a href="/mentions-legales/" class="transition-colors hover:text-text">Mentions légales</a>
    <a href="/llms.txt" class="transition-colors hover:text-text">llms.txt</a>
  </div>
</footer>
