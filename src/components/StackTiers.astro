---
import { getStackTiers } from '../lib/content';

const tiers = await getStackTiers();
---

<section id="stack" class="section-rule mx-auto max-w-6xl px-6 py-20 md:px-12">
  <h2 class="mb-8 text-3xl font-semibold tracking-tight">Stack</h2>
  <!-- The core tier gets the wider column and full-contrast text: it is what a client hires for. -->
  <dl class="grid gap-8 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)_minmax(0,2fr)] md:gap-12">
    {tiers.map(({ data }, index) => (
      <div>
        <dt class="mb-2 font-semibold">{data.name}</dt>
        <dd class:list={['leading-relaxed', index === 0 ? 'text-lg text-text' : 'text-muted']}>{data.items.join(', ')}</dd>
      </div>
    ))}
  </dl>
</section>
