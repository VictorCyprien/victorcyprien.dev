---
import ProjectDiagram from './ProjectDiagram.astro';
import { getPublishedCaseStudyIds, getPublishedProjects } from '../lib/content';
import { formatPeriod } from '../lib/format';

const projects = await getPublishedProjects();
const published = await getPublishedCaseStudyIds();
const featured = projects.filter((project) => project.data.featured);
const others = projects.filter((project) => !project.data.featured);
---

<section id="projets" class="mx-auto max-w-6xl px-6 py-20 md:px-12">
  <h2 class="mb-8 text-3xl font-semibold tracking-tight">Projets</h2>
  <div class="grid gap-6 md:grid-cols-2">
    {featured.map(({ id, data }) => (
      <article class="flex flex-col overflow-hidden rounded-xl border border-line bg-surface shadow-card">
        <ProjectDiagram id={id} class="border-b border-line bg-bg px-6 py-6" />
        <div class="flex flex-1 flex-col p-6">
          <h3 class="text-xl font-semibold">{data.name}</h3>
          {data.period && <p class="mt-1 text-sm text-muted">{formatPeriod(data.period.start, data.period.end)}</p>}
          <p class="mt-4 leading-relaxed text-muted">{data.summary}</p>
          <p class="mt-4 text-sm text-muted">{data.stack.join(', ')}</p>
          {data.caseStudy && published.has(data.caseStudy.id) && (
            <a href={`/etudes-de-cas/${data.caseStudy.id}/`} class="link mt-6 self-start text-sm">Lire l'étude de cas</a>
          )}
        </div>
      </article>
    ))}
  </div>
  {others.length > 0 && (
    <>
      <h3 class="mb-6 mt-16 text-lg font-semibold">Autres projets</h3>
      <ul class="grid gap-x-16 gap-y-8 md:grid-cols-2">
        {others.map(({ data }) => (
          <li>
            <p class="font-medium">{data.name}</p>
            <p class="mt-1 leading-relaxed text-muted">{data.summary}</p>
            <p class="mt-2 text-sm text-muted">{data.stack.join(', ')}</p>
          </li>
        ))}
      </ul>
    </>
  )}
</section>
