---
import { getCareer, getDiplomas } from '../lib/content';
import { formatPeriod } from '../lib/format';

const career = await getCareer();
const diplomas = await getDiplomas();
---

<section id="parcours" class="links mx-auto max-w-6xl px-6 py-20 md:px-12">
  <h2 class="mb-10 text-3xl font-semibold tracking-tight">Parcours</h2>
  <!-- Work leads in the wide column; the diplomas sit beside it on desktop and after it on a phone. -->
  <div class="grid gap-14 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:gap-16">
    <ol class="grid gap-10 border-l border-line pl-6">
      {career.map(({ data }) => (
        <li>
          <p class="text-sm text-muted">{formatPeriod(data.start, data.end)}</p>
          <h3 class="mt-1 text-lg font-semibold">{data.role}, {data.url ? <a href={data.url}>{data.org}</a> : data.org}</h3>
          <p class="text-sm text-muted">{data.place}</p>
          <p class="mt-2 max-w-[42em] leading-relaxed text-muted">{data.summary}</p>
          {data.stack.length > 0 && <p class="mt-2 text-sm text-muted">{data.stack.join(', ')}</p>}
        </li>
      ))}
    </ol>

    <div>
      <h3 class="mb-6 text-xl font-semibold tracking-tight">Diplômes</h3>
      <ol class="grid gap-6">
        {diplomas.map(({ data }) => (
          <li>
            <p class="text-sm tabular-nums text-muted">{data.year}</p>
            <h4 class="mt-1 font-semibold leading-snug">{data.title}, <a href={data.url}>{data.school}</a></h4>
            {data.detail && <p class="mt-2 text-sm leading-relaxed text-muted">{data.detail}</p>}
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

