---
// The architecture of each featured project, drawn from its case study and nothing more.
// A project without a diagram here renders nothing.
interface Props {
  id: string;
  caption?: string;
  class?: string;
}
const { id, caption, class: className } = Astro.props;
const drawn = ['contrapp', 'aura'];
---

{drawn.includes(id) && (
  <figure class={className}>
    {id === 'contrapp' && (
      <svg viewBox="0 0 340 392" role="img" aria-labelledby="diagram-contrapp-title diagram-contrapp-desc" class="diagram mx-auto block h-auto w-full max-w-[360px]">
        <title id="diagram-contrapp-title">Le montage de Contrapp</title>
        <desc id="diagram-contrapp-desc">Les équipes des CFA utilisent une application web. Elle appelle une API en Python avec FastAPI, qui s'appuie sur une base Supabase. L'API passe par Stripe pour les paiements et par DocuSign pour faire signer les contrats à l'entreprise et à l'alternant. L'interface, l'API, la base et la surveillance, avec Grafana, Prometheus et Loki, tournent sur un même serveur VPS Linux, dans des conteneurs Docker.</desc>

        <rect class="node" x="10" y="8" width="180" height="44" rx="10" />
        <text class="role" x="24" y="27">Utilisateurs</text>
        <text class="tech" x="24" y="43">équipes des CFA</text>

        <rect class="frame" x="4" y="68" width="332" height="256" rx="14" />
        <text class="role" x="18" y="300">Serveur VPS</text>
        <text class="tech" x="18" y="316">Linux, Docker</text>

        <path class="wire" d="M100 52 V84" />
        <rect class="node" x="18" y="84" width="170" height="44" rx="10" />
        <text class="role" x="32" y="103">Interface</text>
        <text class="tech" x="32" y="119">application web</text>

        <rect class="watch" x="202" y="84" width="128" height="58" rx="10" />
        <text class="role" x="216" y="103">Surveillance</text>
        <text class="tech" x="216" y="119">Grafana,</text>
        <text class="tech" x="216" y="133">Prometheus, Loki</text>

        <path class="wire" d="M100 128 V154" />
        <rect class="node" x="18" y="154" width="170" height="44" rx="10" />
        <text class="role" x="32" y="173">API</text>
        <text class="tech" x="32" y="189">Python, FastAPI</text>

        <path class="wire" d="M100 198 V224" />
        <rect class="node" x="18" y="224" width="170" height="44" rx="10" />
        <text class="role" x="32" y="243">Base de données</text>
        <text class="tech" x="32" y="259">Supabase, PostgreSQL</text>

        <path class="wire" d="M188 168 H200 V340 M188 184 H289 V340" />
        <rect class="node" x="150" y="340" width="90" height="44" rx="10" />
        <text class="role" x="164" y="359">Paiements</text>
        <text class="tech" x="164" y="375">Stripe</text>
        <rect class="node" x="250" y="340" width="86" height="44" rx="10" />
        <text class="role" x="264" y="359">Signature</text>
        <text class="tech" x="264" y="375">DocuSign</text>
      </svg>
    )}
    {id === 'aura' && (
      <svg viewBox="0 0 340 392" role="img" aria-labelledby="diagram-aura-title diagram-aura-desc" class="diagram mx-auto block h-auto w-full max-w-[360px]">
        <title id="diagram-aura-title">Le montage d'AURA</title>
        <desc id="diagram-aura-desc">L'application mobile est en Flutter, le back-office des clients en marque blanche en Next.js. Les deux appellent trois API en Python avec FastAPI, une par moteur&nbsp;: nutrition, fitness et communauté. Elles sont hébergées sur Railway. Chez Supabase cloud, chaque client en marque blanche a sa propre base, et le grand public a la sienne. Sentry et les métriques de Railway assurent la surveillance.</desc>

        <rect class="node" x="10" y="8" width="156" height="44" rx="10" />
        <text class="role" x="24" y="27">Application mobile</text>
        <text class="tech" x="24" y="43">Flutter</text>
        <rect class="node" x="178" y="8" width="152" height="44" rx="10" />
        <text class="role" x="192" y="27">Back-office</text>
        <text class="tech" x="192" y="43">Next.js</text>

        <rect class="frame" x="4" y="70" width="332" height="110" rx="14" />
        <text class="role" x="18" y="156">Hébergement</text>
        <text class="tech" x="18" y="170">Railway</text>

        <path class="wire" d="M88 52 V62 M254 52 V62 M88 62 H254 M170 62 V86 M68 78 H272 M68 78 V86 M272 78 V86" />
        <rect class="node" x="18" y="86" width="100" height="44" rx="10" />
        <text class="role" x="32" y="105">Nutrition</text>
        <text class="tech" x="32" y="121">FastAPI</text>
        <rect class="node" x="120" y="86" width="100" height="44" rx="10" />
        <text class="role" x="134" y="105">Fitness</text>
        <text class="tech" x="134" y="121">FastAPI</text>
        <rect class="node" x="222" y="86" width="110" height="44" rx="10" />
        <text class="role" x="236" y="105">Communauté</text>
        <text class="tech" x="236" y="121">FastAPI</text>

        <path class="wire" d="M68 130 V140 M170 130 V140 M272 130 V140 M68 140 H272 M170 140 V200" />
        <rect class="frame" x="4" y="200" width="192" height="164" rx="14" />
        <rect class="node" x="30" y="216" width="160" height="44" rx="10" />
        <rect class="node" x="24" y="222" width="160" height="44" rx="10" />
        <rect class="node" x="18" y="228" width="160" height="44" rx="10" />
        <text class="role" x="32" y="247">Marques blanches</text>
        <text class="tech" x="32" y="263">une base chacune</text>
        <rect class="node" x="18" y="284" width="160" height="44" rx="10" />
        <text class="role" x="32" y="303">Grand public</text>
        <text class="tech" x="32" y="319">une base</text>
        <text class="role" x="18" y="352">Supabase cloud</text>

        <path class="watch-wire" d="M310 216 V180" />
        <rect class="watch" x="202" y="216" width="134" height="58" rx="10" />
        <text class="role" x="214" y="235">Surveillance</text>
        <text class="tech" x="214" y="251">Sentry,</text>
        <text class="tech" x="214" y="265">métriques Railway</text>
      </svg>
    )}
    {caption && <figcaption class="mt-4 text-center text-sm text-muted">{caption}</figcaption>}
  </figure>
)}
