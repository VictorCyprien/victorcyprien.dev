---
// The architecture of each featured project, drawn from its case study and nothing more.
// A project without a diagram here renders nothing.
// No <title> in the drawings: browsers show it as a tooltip over the hover effect, so aria-label names them.
// Hovering a brick with a mouse lights it, what it links to and the wires between, and shows its role
// (data-role) under the drawing. data-links lists the bricks it links to; data-for lists the bricks a
// wire lights for; a shared line is cut at each junction so the lit path stops where it should.
// Touch screens get the still drawing.
interface Props {
  id: string;
  caption?: string;
  class?: string;
}
const { id, caption, class: className } = Astro.props;
const drawn = ['contrapp', 'aura'];
---

{drawn.includes(id) && (
  <figure class={className} data-diagram={id}>
    {id === 'contrapp' && (
      <svg viewBox="0 -9 340 410" role="img" aria-label="Le montage de Contrapp" aria-describedby="diagram-contrapp-desc" class="diagram mx-auto block h-auto w-full max-w-[360px]">
        <desc id="diagram-contrapp-desc">L'application web des CFA est en React, construite avec Vite. Elle appelle une API en Python avec FastAPI, qui s'appuie sur une base Supabase. L'API passe par Stripe pour les paiements et par DocuSign pour faire signer les contrats à l'entreprise et à l'alternant. L'interface, l'API, la base et la surveillance, avec Grafana, Prometheus et Loki, tournent sur un même serveur VPS Linux, dans des conteneurs Docker.</desc>

        <g data-id="users" data-links="interface" data-role="L'équipe du CFA y a créé ses contrats d'alternance et les a envoyés en signature.">
          <rect class="node" x="10" y="8" width="180" height="44" rx="10" />
          <text class="role" x="24" y="27">Utilisateurs</text>
          <text class="tech" x="24" y="43">équipes des CFA</text>
        </g>

        <g data-id="vps" data-links="interface api db watch" data-role="Tout tourne sur un même serveur, dans des conteneurs Docker&nbsp;: le montage le plus simple pour une équipe qui découvrait le cloud.">
          <rect class="frame" x="4" y="68" width="332" height="256" rx="14" />
          <text class="role" x="18" y="300">Serveur VPS</text>
          <text class="tech" x="18" y="316">Linux, Docker</text>
        </g>

        <path class="wire" data-for="users interface" d="M100 52 V84" />
        <g data-id="interface" data-links="users api vps" data-role="L'application web des CFA, en React avec Vite.">
          <rect class="node" x="18" y="84" width="170" height="44" rx="10" />
          <text class="role" x="32" y="103">Interface</text>
          <text class="tech" x="32" y="119">React, Vite</text>
        </g>

        <g data-id="watch" data-links="vps" data-role="En place dès la première mise en ligne&nbsp;: erreurs, lenteurs et ressources du serveur sont visibles avant le premier incident.">
          <rect class="watch" x="202" y="84" width="128" height="58" rx="10" />
          <text class="role" x="216" y="103">Surveillance</text>
          <text class="tech" x="216" y="119">Grafana,</text>
          <text class="tech" x="216" y="133">Prometheus, Loki</text>
        </g>

        <path class="wire" data-for="interface api vps" d="M100 128 V154" />
        <g data-id="api" data-links="interface db stripe docusign vps" data-role="Reprise point par point&nbsp;: la route reçoit la requête, un service porte la logique métier, l'accès aux données est regroupé.">
          <rect class="node" x="18" y="154" width="170" height="44" rx="10" />
          <text class="role" x="32" y="173">API</text>
          <text class="tech" x="32" y="189">Python, FastAPI</text>
        </g>

        <path class="wire" data-for="api db vps" d="M100 198 V224" />
        <g data-id="db" data-links="api vps" data-role="Supabase apporte l'authentification, le stockage de fichiers et les règles d'accès par ligne.">
          <rect class="node" x="18" y="224" width="170" height="44" rx="10" />
          <text class="role" x="32" y="243">Base de données</text>
          <text class="tech" x="32" y="259">Supabase, PostgreSQL</text>
        </g>

        <path class="wire" data-for="api stripe" d="M188 168 H200 V340" />
        <path class="wire" data-for="api docusign" d="M188 184 H289 V340" />
        <g data-id="stripe" data-links="api" data-role="Facturation au contrat, par paliers, avec un tarif adapté à la taille de chaque CFA.">
          <rect class="node" x="150" y="340" width="90" height="44" rx="10" />
          <text class="role" x="164" y="359">Paiements</text>
          <text class="tech" x="164" y="375">Stripe</text>
        </g>
        <g data-id="docusign" data-links="api" data-role="L'entreprise et l'alternant signent le contrat en ligne, via DocuSign.">
          <rect class="node" x="250" y="340" width="86" height="44" rx="10" />
          <text class="role" x="264" y="359">Signature</text>
          <text class="tech" x="264" y="375">DocuSign</text>
        </g>
      </svg>
    )}
    {id === 'aura' && (
      <svg viewBox="0 0 340 410" role="img" aria-label="Le montage d'AURA" aria-describedby="diagram-aura-desc" class="diagram mx-auto block h-auto w-full max-w-[360px]">
        <desc id="diagram-aura-desc">Une marque qui prend AURA en marque blanche reçoit sa propre application mobile en Flutter, adaptée à son image, et le grand public a son application. Ces applications appellent trois API en Python avec FastAPI, une par moteur&nbsp;: nutrition, fitness et communauté. BeAble2 héberge sur Railway ces API et le back-office en Next.js de chaque marque. Dans l'organisation Supabase de BeAble2, chaque marque a sa propre base, qui lui appartient, et la base du grand public appartient à BeAble2. Sentry et les métriques de Railway assurent la surveillance.</desc>

