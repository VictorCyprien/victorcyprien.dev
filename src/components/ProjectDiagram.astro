          <text class="role" x="236" y="111">Communauté</text>
          <text class="tech" x="236" y="127">FastAPI</text>
        </g>

        <path class="wire" data-for="nutrition backoffice supabase bases public-base" d="M68 136 V148" />
        <path class="wire" data-for="fitness backoffice supabase bases public-base" d="M170 136 V148" />
        <path class="wire" data-for="communaute backoffice supabase bases public-base" d="M272 136 V148" />
        <path class="wire" data-for="nutrition backoffice supabase bases public-base" d="M68 148 H120" />
        <path class="wire" data-for="nutrition fitness communaute backoffice supabase bases public-base" d="M120 148 H250" />
        <path class="wire" data-for="communaute backoffice supabase bases public-base" d="M250 148 H272" />
        <path class="wire" data-for="backoffice nutrition fitness communaute" d="M250 148 V166" />
        <path class="wire" data-for="supabase bases public-base nutrition fitness communaute" d="M120 148 V250" />
        <g data-id="backoffice" data-links="nutrition fitness communaute railway" data-role="Un back-office par marque, hébergé chez nous&nbsp;: la marque n'a rien à gérer.">
          <rect class="node" x="184" y="166" width="144" height="44" rx="10" />
          <rect class="node" x="178" y="172" width="144" height="44" rx="10" />
          <rect class="node" x="172" y="178" width="144" height="44" rx="10" />
          <text class="role" x="186" y="197">Back-offices</text>
