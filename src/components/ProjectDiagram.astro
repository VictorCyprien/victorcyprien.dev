          <rect class="node" x="120" y="92" width="100" height="44" rx="10" />
          <text class="role" x="134" y="111">Fitness</text>
          <text class="tech" x="134" y="127">FastAPI</text>
        </g>
        <g data-id="communaute" data-links="brands public backoffice bases public-base supabase railway" data-role="Un des trois moteurs&nbsp;: une API à part, déployée comme un service séparé.">
