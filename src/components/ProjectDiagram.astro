---
// The architecture of each featured project, drawn from its case study and nothing more.
// A project without a diagram here renders nothing.
interface Props {
  id: string;
  caption?: string;
  class?: string;
}
const { id, caption, class: className } = Astro.props;
const drawn = ['contrapp', 'aura'];
---

{drawn.includes(id) && (
  <figure class={className}>
    {id === 'contrapp' && (
      <svg viewBox="0 -9 340 410" role="img" aria-labelledby="diagram-contrapp-title diagram-contrapp-desc" class="diagram mx-auto block h-auto w-full max-w-[360px]">
        <title id="diagram-contrapp-title">Le montage de Contrapp</title>
        <desc id="diagram-contrapp-desc">Les équipes des CFA utilisent une application web en React, construite avec Vite. Elle appelle une API en Python avec FastAPI, qui s'appuie sur une base Supabase. L'API passe par Stripe pour les paiements et par DocuSign pour faire signer les contrats à l'entreprise et à l'alternant. L'interface, l'API, la base et la surveillance, avec Grafana, Prometheus et Loki, tournent sur un même serveur VPS Linux, dans des conteneurs Docker.</desc>

        <rect class="node" x="10" y="8" width="180" height="44" rx="10" />
        <text class="role" x="24" y="27">Utilisateurs</text>
        <text class="tech" x="24" y="43">équipes des CFA</text>

        <rect class="frame" x="4" y="68" width="332" height="256" rx="14" />
        <text class="role" x="18" y="300">Serveur VPS</text>
        <text class="tech" x="18" y="316">Linux, Docker</text>

        <path class="wire" d="M100 52 V84" />
        <rect class="node" x="18" y="84" width="170" height="44" rx="10" />
        <text class="role" x="32" y="103">Interface</text>
        <text class="tech" x="32" y="119">React, Vite</text>

        <rect class="watch" x="202" y="84" width="128" height="58" rx="10" />
        <text class="role" x="216" y="103">Surveillance</text>
        <text class="tech" x="216" y="119">Grafana,</text>
        <text class="tech" x="216" y="133">Prometheus, Loki</text>

        <path class="wire" d="M100 128 V154" />
        <rect class="node" x="18" y="154" width="170" height="44" rx="10" />
        <text class="role" x="32" y="173">API</text>
        <text class="tech" x="32" y="189">Python, FastAPI</text>

        <path class="wire" d="M100 198 V224" />
        <rect class="node" x="18" y="224" width="170" height="44" rx="10" />
        <text class="role" x="32" y="243">Base de données</text>
        <text class="tech" x="32" y="259">Supabase, PostgreSQL</text>

        <path class="wire" d="M188 168 H200 V340 M188 184 H289 V340" />
        <rect class="node" x="150" y="340" width="90" height="44" rx="10" />
        <text class="role" x="164" y="359">Paiements</text>
        <text class="tech" x="164" y="375">Stripe</text>
        <rect class="node" x="250" y="340" width="86" height="44" rx="10" />
        <text class="role" x="264" y="359">Signature</text>
        <text class="tech" x="264" y="375">DocuSign</text>
      </svg>
    )}
    {id === 'aura' && (
      <svg viewBox="0 0 340 410" role="img" aria-labelledby="diagram-aura-title diagram-aura-desc" class="diagram mx-auto block h-auto w-full max-w-[360px]">
        <title id="diagram-aura-title">Le montage d'AURA</title>
        <desc id="diagram-aura-desc">Chaque marque reçoit sa propre application mobile en Flutter, adaptée à son image, et le grand public a son application. Ces applications appellent trois API en Python avec FastAPI, une par moteur&nbsp;: nutrition, fitness et communauté. BeAble2 héberge sur Railway ces API et le back-office en Next.js de chaque marque. Dans l'organisation Supabase de BeAble2, chaque marque a sa propre base, qui lui appartient, et la base du grand public appartient à BeAble2. Sentry et les métriques de Railway assurent la surveillance.</desc>

        <rect class="node" x="22" y="4" width="160" height="44" rx="10" />
        <rect class="node" x="16" y="10" width="160" height="44" rx="10" />
        <rect class="node" x="10" y="16" width="160" height="44" rx="10" />
        <text class="role" x="24" y="35">Apps des marques</text>
        <text class="tech" x="24" y="51">Flutter</text>
        <rect class="node" x="194" y="16" width="136" height="44" rx="10" />
        <text class="role" x="208" y="35">App grand public</text>
        <text class="tech" x="208" y="51">Flutter</text>

        <rect class="frame" x="4" y="80" width="332" height="154" rx="14" />
        <text class="role" x="18" y="206">Hébergement</text>
        <text class="tech" x="18" y="222">Railway</text>

        <path class="wire" d="M90 60 V70 M262 60 V70 M68 70 H272 M68 70 V92 M170 70 V92 M272 70 V92" />
        <rect class="node" x="18" y="92" width="100" height="44" rx="10" />
        <text class="role" x="32" y="111">Nutrition</text>
        <text class="tech" x="32" y="127">FastAPI</text>
        <rect class="node" x="120" y="92" width="100" height="44" rx="10" />
        <text class="role" x="134" y="111">Fitness</text>
        <text class="tech" x="134" y="127">FastAPI</text>
        <rect class="node" x="222" y="92" width="110" height="44" rx="10" />
        <text class="role" x="236" y="111">Communauté</text>
        <text class="tech" x="236" y="127">FastAPI</text>

        <path class="wire" d="M68 136 V148 M170 136 V148 M272 136 V148 M68 148 H272 M250 148 V166 M120 148 V250" />
        <rect class="node" x="184" y="166" width="144" height="44" rx="10" />
        <rect class="node" x="178" y="172" width="144" height="44" rx="10" />
        <rect class="node" x="172" y="178" width="144" height="44" rx="10" />
        <text class="role" x="186" y="197">Back-offices</text>
        <text class="tech" x="186" y="213">Next.js</text>

        <rect class="frame" x="4" y="250" width="192" height="154" rx="14" />
        <rect class="node" x="30" y="262" width="160" height="44" rx="10" />
        <rect class="node" x="24" y="268" width="160" height="44" rx="10" />
        <rect class="node" x="18" y="274" width="160" height="44" rx="10" />
        <text class="role" x="32" y="293">Bases des marques</text>
        <text class="tech" x="32" y="309">à chaque marque</text>
        <rect class="node" x="18" y="328" width="160" height="44" rx="10" />
        <text class="role" x="32" y="347">Base grand public</text>
        <text class="tech" x="32" y="363">à BeAble2</text>
        <text class="role" x="18" y="392">Supabase cloud</text>

        <path class="watch-wire" d="M300 262 V234" />
        <rect class="watch" x="202" y="262" width="134" height="58" rx="10" />
        <text class="role" x="214" y="281">Surveillance</text>
        <text class="tech" x="214" y="297">Sentry,</text>
        <text class="tech" x="214" y="311">métriques Railway</text>
      </svg>
    )}
    {caption && <figcaption class="mt-4 text-center text-sm text-muted">{caption}</figcaption>}
  </figure>
)}
