          <rect class="frame" x="4" y="250" width="192" height="154" rx="14" />
          <text class="role" x="18" y="392">Supabase cloud</text>
        </g>
        <g data-id="bases" data-links="supabase nutrition fitness communaute" data-role="Une base par marque, dans notre organisation Supabase. Elle appartient à la marque, et ses données restent à part.">
          <rect class="node" x="30" y="262" width="160" height="44" rx="10" />
          <rect class="node" x="24" y="268" width="160" height="44" rx="10" />
          <rect class="node" x="18" y="274" width="160" height="44" rx="10" />
          <text class="role" x="32" y="293">Bases des marques</text>
          <text class="tech" x="32" y="309">à chaque marque</text>
        </g>
        <g data-id="public-base" data-links="supabase nutrition fitness communaute" data-role="La base du grand public, qui appartient à BeAble2.">
          <rect class="node" x="18" y="328" width="160" height="44" rx="10" />
          <text class="role" x="32" y="347">Base grand public</text>
          <text class="tech" x="32" y="363">à BeAble2</text>
        </g>

        <path class="watch-wire" data-for="watch railway" d="M300 262 V234" />
        <g data-id="watch" data-links="railway" data-role="Sentry remonte les erreurs, Railway fournit les métriques. Tant que ça suffit, on n'ajoute rien de plus.">
          <rect class="watch" x="202" y="262" width="134" height="58" rx="10" />
          <text class="role" x="214" y="281">Surveillance</text>
          <text class="tech" x="214" y="297">Sentry,</text>
          <text class="tech" x="214" y="311">métriques Railway</text>
        </g>
      </svg>
    )}
    <p class="diagram-note mx-auto mt-4 min-h-[4.875em] max-w-[34em] text-center text-sm leading-relaxed text-muted" aria-hidden="true" data-diagram-note>Passez la souris sur une brique pour voir son rôle.</p>
    {caption && <figcaption class="mt-4 text-center text-sm text-muted">{caption}</figcaption>}
  </figure>
)}

<script>
  for (const figure of document.querySelectorAll<HTMLElement>('figure[data-diagram]')) {
    const svg = figure.querySelector('svg');
    const note = figure.querySelector<HTMLElement>('[data-diagram-note]');
    if (!svg || !note) continue;
    const hint = note.textContent ?? '';
    const bricks = [...svg.querySelectorAll<SVGGElement>('[data-id]')];
    const wires = [...svg.querySelectorAll<SVGPathElement>('[data-for]')];

    const trace = (brick: SVGGElement | null) => {
      const id = brick?.dataset.id ?? '';
      const near = new Set(brick?.dataset.links?.split(' ') ?? []);
      svg.classList.toggle('tracing', brick !== null);
      for (const other of bricks) {
        other.classList.toggle('is-hot', other === brick);
        other.classList.toggle('is-lit', near.has(other.dataset.id ?? ''));
      }
      for (const wire of wires) wire.classList.toggle('is-lit', id !== '' && (wire.dataset.for ?? '').split(' ').includes(id));
      if (!brick) {
        note.textContent = hint;
        return;
      }
      const name = document.createElement('strong');
      name.className = 'font-medium text-text';
      name.textContent = `${brick.querySelector('.role')?.textContent ?? ''}.`;
      note.replaceChildren(name, ` ${brick.dataset.role ?? ''}`);
    };

    // Only a mouse or a pen traces: a tap on a touch screen leaves the drawing still.
    for (const brick of bricks) {
      brick.addEventListener('pointerenter', (event) => { if (event.pointerType !== 'touch') trace(brick); });
      brick.addEventListener('pointerleave', (event) => { if (event.pointerType !== 'touch') trace(null); });
    }
  }
</script>
