        <path class="wire" data-for="brands public nutrition fitness communaute" d="M90 70 H262" />
        <path class="wire" data-for="brands public communaute" d="M262 70 H272" />
        <path class="wire" data-for="brands public nutrition" d="M68 70 V92" />
        <path class="wire" data-for="brands public fitness" d="M170 70 V92" />
        <path class="wire" data-for="brands public communaute" d="M272 70 V92" />
        <g data-id="nutrition" data-links="brands public backoffice bases public-base supabase railway" data-role="Un des trois moteurs&nbsp;: une API à part, déployée comme un service séparé. Un particulier peut n'utiliser que celui-ci.">
          <rect class="node" x="18" y="92" width="100" height="44" rx="10" />
