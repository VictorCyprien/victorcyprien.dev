---
// A case study's table of contents: folded on a phone, pinned beside the text on a desktop screen.
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  class?: string;
}
const { headings, class: className } = Astro.props;
---

<nav aria-label="Sommaire" class={className}>
  <details class="rounded-xl border border-line px-4 py-3" data-toc>
    <summary class="cursor-pointer py-1 font-semibold">Sommaire</summary>
    <ul class="mt-2 grid gap-0.5 text-sm">
      {headings.map((heading) => (
        <li class:list={[heading.depth > 2 && 'pl-3']}>
          <a href={`#${heading.slug}`} class="block border-l-2 border-transparent py-1 pl-3 leading-snug text-muted transition-colors hover:text-text">{heading.text}</a>
        </li>
      ))}
    </ul>
    <span class="toc-marker" aria-hidden="true"></span>
  </details>
</nav>

<style>
  /* Pinned on a desktop screen: always open, no fold control, no frame. */
  details[data-pinned] { border-color: transparent; padding: 0; }
  details[data-pinned] summary { display: none; }
  details[data-pinned] ul { margin-top: 0; }
  a[aria-current] { color: var(--text); }
  /* One veille bar marks the current section and glides to the next one as the reader moves on.
     It is a 1px bar stretched to the link's height, so the glide only moves transforms. */
  details { position: relative; }
  .toc-marker {
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 1px;
    background: var(--watch);
    transform-origin: 0 0;
    opacity: 0;
    pointer-events: none;
  }
  .toc-marker[data-placed] { opacity: 1; }
  .toc-marker[data-gliding] { transition: transform 250ms var(--ease-settle); }
</style>

<script>
  const details = document.querySelector<HTMLDetailsElement>('[data-toc]');
  if (details) {
    const marker = details.querySelector<HTMLElement>('.toc-marker');
    let current: HTMLAnchorElement | undefined;

    // Glides from the previous section; jumps when the list has just opened or changed size.
    const place = (glide: boolean) => {
      if (!marker) return;
      if (!current || current.offsetHeight === 0) {
        marker.removeAttribute('data-placed');
        return;
      }
      marker.toggleAttribute('data-gliding', glide && marker.hasAttribute('data-placed'));
      marker.style.transform = `translate(${current.offsetLeft}px, ${current.offsetTop}px) scaleY(${current.offsetHeight})`;
      marker.setAttribute('data-placed', '');
    };
    // Opening the list, a new breakpoint, a resize or the web font arriving all move the links.
    const list = details.querySelector('ul');
    if (list) new ResizeObserver(() => place(false)).observe(list);

    const wide = window.matchMedia('(min-width: 1024px)');
    const pin = () => {
      details.open = wide.matches;
      details.toggleAttribute('data-pinned', wide.matches);
    };
    pin();
    wide.addEventListener('change', pin);

    const entries = [...details.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]
      .map((link) => ({ link, target: document.getElementById(decodeURIComponent(link.hash.slice(1))) }))
      .filter((entry): entry is { link: HTMLAnchorElement; target: HTMLElement } => entry.target !== null);

    // The current section is the last heading that has reached the top of the screen. The line sits just
    // below the 2rem scroll margin, so a heading reached from the table of contents counts as current.
    let frame = 0;
    const update = () => {
      frame = 0;
      const line = 80;
      let reached = entries[0];
      for (const entry of entries) if (entry.target.getBoundingClientRect().top <= line) reached = entry;
      for (const { link } of entries) {
        if (link === reached?.link) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
      if (reached?.link !== current) {
        current = reached?.link;
        place(true);
      }
    };
    window.addEventListener('scroll', () => { frame ||= requestAnimationFrame(update); }, { passive: true });
    update();
  }
</script>
