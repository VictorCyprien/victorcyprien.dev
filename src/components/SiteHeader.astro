---
import ThemeToggle from './ThemeToggle.astro';
import { getSite } from '../lib/content';

const site = await getSite();
const links = [
  { href: '/#principes', label: 'Comment je décide' },
  { href: '/#projets', label: 'Projets' },
  { href: '/#parcours', label: 'Parcours' },
  { href: '/etudes-de-cas/', label: 'Études de cas' },
];
---

<header class="mx-auto flex max-w-6xl items-center gap-6 px-6 py-5 md:px-12">
  <a href="/" class="mr-auto font-semibold">{site.name}</a>
  <nav aria-label="Navigation principale" class="hidden gap-6 text-sm text-muted md:flex">
    {links.map((link) => <a href={link.href} class="hover:text-text">{link.label}</a>)}
  </nav>
  <ThemeToggle />
  <a href={site.callHref} class="rounded-[10px] bg-cta px-4 py-2 text-sm font-medium text-cta-text">Réserver un appel</a>
</header>
