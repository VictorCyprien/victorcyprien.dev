---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CallBlock from '../../components/CallBlock.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import CaseStudyToc from '../../components/CaseStudyToc.astro';
import ProjectDiagram from '../../components/ProjectDiagram.astro';
import { getPrinciples, getPublishedCaseStudies, getSite } from '../../lib/content';
import { caseStudyGraph } from '../../lib/schema';
import { formatPeriod } from '../../lib/format';
import { readingMinutes } from '../../lib/reading';

export async function getStaticPaths() {
  const studies = await getPublishedCaseStudies();
  return studies.map((study) => ({ params: { slug: study.id }, props: { study, others: studies.filter((other) => other !== study) } }));
}

const { study, others } = Astro.props;
const { Content, headings } = await render(study);
const site = await getSite();
const { title, seoTitle, seoDescription, summary, brief, sector, period, stack } = study.data;
// In the home page order, whatever the order in the front matter.
const principles = (await getPrinciples()).filter((principle) => study.data.principles.some((ref) => ref.id === principle.id));
const minutes = readingMinutes([brief.need, brief.work, brief.result, study.body ?? ''].join(' '));
// "En bref" and "Stack" are written in this template, around the Markdown headings.
const toc = [
  { depth: 2, slug: 'en-bref', text: 'En bref' },
  ...headings.filter((heading) => heading.depth <= 3),
  { depth: 2, slug: 'stack', text: 'Stack' },
];
---

<BaseLayout title={seoTitle ?? `${title}, Victor Cyprien`} description={seoDescription ?? summary} jsonLd={caseStudyGraph(study, site, Astro.site!)}>
  <!-- On a phone the table of contents sits between the header and the text; on a desktop screen it is pinned in its own column. -->
  <article class="mx-auto grid max-w-6xl px-6 py-16 md:px-12 lg:grid-cols-[minmax(0,1fr)_200px] lg:grid-rows-[auto_1fr] lg:gap-x-12 xl:grid-cols-[minmax(0,48rem)_220px] xl:justify-between">
    <header class="min-w-0">
      <a href="/etudes-de-cas/" class="text-sm text-muted transition-colors hover:text-text">Toutes les études de cas</a>
      <h1 class="mb-8 mt-6 text-balance text-4xl font-semibold leading-tight tracking-tight">{title}</h1>
      <section aria-labelledby="en-bref" class="mb-8 rounded-xl border border-line bg-surface p-6">
        <h2 id="en-bref" class="mb-4 text-lg font-semibold">En bref</h2>
        <dl class="grid gap-x-6 gap-y-1 sm:grid-cols-[130px_minmax(0,1fr)] sm:gap-y-3">
          <dt class="mt-3 text-sm text-muted first:mt-0 sm:mt-0 sm:pt-0.5">Le besoin</dt><dd class="leading-relaxed">{brief.need}</dd>
          <dt class="mt-3 text-sm text-muted first:mt-0 sm:mt-0 sm:pt-0.5">Ce que j'ai fait</dt><dd class="leading-relaxed">{brief.work}</dd>
          <dt class="mt-3 text-sm text-muted first:mt-0 sm:mt-0 sm:pt-0.5">Le résultat</dt><dd class="leading-relaxed">{brief.result}</dd>
        </dl>
      </section>
      <dl class="mb-8 grid gap-x-6 gap-y-2 border-y border-line py-5 text-sm sm:grid-cols-[120px_minmax(0,1fr)] lg:mb-12">
        <dt class="text-muted">Secteur</dt><dd>{sector}</dd>
        <dt class="text-muted">Période</dt><dd>{formatPeriod(period.start, period.end)}</dd>
        <dt class="text-muted">Lecture</dt><dd>{minutes} min</dd>
        {principles.length > 0 && (
          <>
            <dt class="text-muted">Principes</dt>
            <dd>
              <ul class="space-y-1">
                {principles.map((principle) => <li><a href={`/#principe-${principle.id}`} class="link">{principle.data.title}</a></li>)}
              </ul>
            </dd>
          </>
        )}
      </dl>
    </header>
    <CaseStudyToc headings={toc} class="mb-12 lg:sticky lg:top-8 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mb-0 lg:max-h-[calc(100vh-4rem)] lg:self-start lg:overflow-y-auto" />
    <div class="min-w-0">
      <ProjectDiagram id={study.id} caption="Le montage en production, simplifié." class="mb-12 rounded-xl border border-line p-6" />
      <div class="case-study links">
        <Content />
        <h2 id="stack">Stack</h2>
        <p class="text-sm">{stack.join(', ')}</p>
      </div>
      {others.length > 0 && (
        <section aria-labelledby="autres-etudes" class="mt-16">
          <h2 id="autres-etudes" class="mb-6 text-2xl font-semibold tracking-tight">{others.length === 1 ? 'Autre étude de cas' : 'Autres études de cas'}</h2>
          <ul class="grid gap-6">
            {others.map((other) => <li><CaseStudyCard study={other} heading="h3" /></li>)}
          </ul>
        </section>
      )}
      <CallBlock class="mt-16" />
    </div>
  </article>
</BaseLayout>

<style>
  .case-study :global(h2) { margin: 2.5rem 0 1rem; font-size: 1.5rem; font-weight: 600; }
  .case-study :global(h3) { margin: 1.75rem 0 0.5rem; font-size: 1.125rem; font-weight: 600; }
  /* A heading reached from the table of contents keeps some air above it. */
  .case-study :global(:is(h2, h3)), #en-bref { scroll-margin-top: 2rem; }
  .case-study :global(p) { margin-bottom: 1rem; line-height: 1.7; color: var(--muted); }
  .case-study :global(ul) { list-style: disc; padding-left: 1.25rem; margin-bottom: 1rem; color: var(--muted); }
  .case-study :global(ol) { list-style: decimal; padding-left: 1.25rem; margin-bottom: 1rem; color: var(--muted); }
  .case-study :global(li) { margin-bottom: 0.25rem; line-height: 1.7; }
</style>
