---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedCaseStudies } from '../../lib/content';
import { formatPeriod } from '../../lib/format';

const studies = await getPublishedCaseStudies();
---

<BaseLayout title="Études de cas, Victor Cyprien" description="Les projets en détail : le contexte, les décisions prises et leurs raisons, le résultat.">
  <section class="mx-auto max-w-6xl px-6 py-16 md:px-12">
    <h1 class="mb-3 text-4xl font-semibold tracking-tight">Études de cas</h1>
    <p class="mb-10 max-w-[40em] text-muted">Les projets en détail&nbsp;: le contexte, les décisions prises et leurs raisons, le résultat.</p>
    {studies.length === 0 ? (
      <p class="text-muted">Aucune étude de cas publiée pour le moment. Les projets sont décrits sur la <a href="/#projets" class="border-b border-watch text-text transition-colors hover:border-text">page d'accueil</a>.</p>
    ) : (
      <ul class="grid gap-6 md:grid-cols-2">
        {studies.map((study) => (
          <li>
            <a href={`/etudes-de-cas/${study.id}/`} class="block h-full rounded-xl border border-line bg-surface p-6 transition-colors hover:border-watch">
              <h2 class="text-xl font-semibold">{study.data.title}</h2>
              <p class="mt-1 text-sm text-muted">{study.data.sector}, {formatPeriod(study.data.period.start, study.data.period.end)}</p>
              <p class="mt-4 leading-relaxed text-muted">{study.data.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
