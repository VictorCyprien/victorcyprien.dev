---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Principles from '../components/Principles.astro';
import Projects from '../components/Projects.astro';
import Career from '../components/Career.astro';
import StackTiers from '../components/StackTiers.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { getSite } from '../lib/content';

const site = await getSite();
---

<BaseLayout title={`${site.name}, back-end et DevOps freelance`} description={site.lead}>
  <Hero />
  <Principles />
  <Projects />
  <Career />
  <StackTiers />
  <About />
  <Contact />
</BaseLayout>
