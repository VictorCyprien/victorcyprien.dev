---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Principles from '../components/Principles.astro';
import Projects from '../components/Projects.astro';
import Career from '../components/Career.astro';
import StackTiers from '../components/StackTiers.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { getSite } from '../lib/content';
import { homeGraph } from '../lib/schema';

const site = await getSite();
---

<BaseLayout title={`${site.jobTitle} à ${site.city}, ${site.name}`} description={site.description} jsonLd={homeGraph(site, Astro.site!)}>
  <Hero />
  <Principles />
  <Projects />
  <Career />
  <StackTiers />
  <About />
  <Contact />
</BaseLayout>
